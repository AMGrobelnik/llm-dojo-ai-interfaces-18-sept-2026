{
  "cleanupPeriodDays": 3650,
  "env": {
    "CONTEXT7_API_KEY": "<REDACTED>",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "100000",
    "CLAUDE_CODE_RECAP_TURN_SECONDS": "10"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-fable-5-1[1m]",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/agent_type_gate.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/guard_destructive_git.py\"; [ -r \"$f\" ] && exec python3 \"$f\" || exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/turn_recap.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ralph-loop@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": false
  },
  "outputStyle": "Concise",
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-4-6": {
      "effortLevel": "high"
    }
  },
  "ultracode": false,
  "autoCompactWindow": 200000,
  "remote": {
    "defaultEnvironmentId": "<REDACTED>"
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "prefersReducedMotion": true,
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "verbose": true,
  "switchModelsOnFlag": false,
  "fileCheckpointingEnabled": false,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}